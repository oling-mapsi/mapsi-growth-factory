{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "feature_id",
      "module",
      "title",
      "short_description",
      "business_problem",
      "functional_description",
      "user_benefits",
      "typical_use_cases",
      "target_roles",
      "communication_priority",
      "communication_enabled",
      "minimum_repeat_delay_days",
      "source_references",
      "forbidden_claims"
    ],
    "properties": {
      "feature_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "module": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "short_description": {
        "type": "string",
        "minLength": 1
      },
      "business_problem": {
        "type": "string",
        "minLength": 1
      },
      "functional_description": {
        "type": "string",
        "minLength": 1
      },
      "user_benefits": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "typical_use_cases": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "target_roles": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "communication_priority": {
        "type": "integer",
        "minimum": 1
      },
      "communication_enabled": {
        "type": "boolean"
      },
      "minimum_repeat_delay_days": {
        "type": "integer",
        "minimum": 1
      },
      "source_references": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "forbidden_claims": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
