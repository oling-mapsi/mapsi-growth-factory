{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductChangeCollection",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "generated_at", "items"],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "url", "published_at", "tags", "communicable"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "communicable": {"type": "boolean"}
        }
      }
    }
  }
}
