APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://mapsi:mapsi@postgres:5432/mapsi_growth_factory
TEST_DATABASE_URL=postgresql+psycopg://mapsi:mapsi@postgres:5432/mapsi_growth_factory_test
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=mapsi:growth:tasks
MAPSI_API_KEY=change-me
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_ALLOWED_REPOSITORIES=mapsi/mapsi-v6
GITHUB_API_URL=https://api.github.com
GITHUB_CONTRACT_PATH=growth/change-notes
CONTACT_HASH_SALT=change-me-contact-salt
CONTACT_ENCRYPTION_KEY=change-me-contact-encryption-key
AUDIENCE_SEGMENT_MIN_SIZE=1
AUDIENCE_SEGMENT_MAX_SIZE=10000
MAUTIC_BASE_URL=http://localhost:8020
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
MAUTIC_ACCESS_TOKEN=change-me
MAUTIC_VERIFY_TLS=false
LINKEDIN_MODE=mock
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/ops/linkedin/oauth/callback
LINKEDIN_COMPANY_ID=3347696
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_API_VERSION=202506
LINKEDIN_SCOPE=openid profile email w_member_social rw_organization_admin w_organization_social r_organization_social
LINKEDIN_VERIFY_TLS=true
MAUTIC_CATEGORY_NAME=MAPSI Growth
MAUTIC_WEEKLY_TEMPLATE_NAME=MAPSI Weekly Update
MAUTIC_WEEKLY_CAMPAIGN_NAME=MAPSI Weekly Nurture Disabled
EDITORIAL_AGENT_BACKEND=simulated
EDITORIAL_AGENT_MODEL=gpt-4.1-mini
EDITORIAL_AGENT_TEMPERATURE=0.2
REVIEW_ADMIN_USERNAME=admin
REVIEW_ADMIN_PASSWORD=change-me-review-password
REVIEW_SAMPLE_AUTHORIZED_USERS=
REVIEW_TOKEN_TTL_MINUTES=120
REVIEW_TOKEN_MAX_USES=20
WORKFLOW_KILL_SWITCH=false
PUBLICATION_INSTANCE_KILL_SWITCHES=
PUBLICATION_CLIENT_KILL_SWITCHES=
MAILPIT_BASE_URL=http://mailpit:8025
ADOPTION_ALERT_UNSUBSCRIBE_RATE=0.03
ADOPTION_ALERT_BOUNCE_RATE=0.02
ADOPTION_ALERT_DELIVERABILITY_FLOOR=0.95
ADOPTION_ALERT_EFFECT_FLOOR=0.01
ADOPTION_ALERT_ERROR_RATE=0.05
MAPSI_INSTANCES=|
  instances:
    - id: gpmlm
      base_url: https://mapsi-client-1.example
      secret_ref: vault://mapsi/gpmlm/growth-token
      enabled: true
    - id: gpmg
      base_url: https://mapsi-client-2.example
      secret_ref: vault://mapsi/gpmg/growth-token
      enabled: false
