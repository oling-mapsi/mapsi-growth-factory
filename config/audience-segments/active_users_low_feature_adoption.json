{
  "id": "active_users_low_feature_adoption",
  "label": "Utilisateurs actifs avec faible adoption",
  "description": "Utilisateurs actifs eligibles avec peu d'usage recent des fonctionnalites.",
  "enabled": true,
  "legal_basis": "legitimate_interest_adoption",
  "conditions": {
    "all": [
      { "field": "active", "operator": "equals", "value": true },
      { "field": "communication_eligible", "operator": "equals", "value": true },
      { "field": "total_feature_events_7d", "operator": "less_or_equal", "value": 2 }
    ]
  },
  "exclusions": ["opted_out", "invalid_email", "account_suspended"]
}
