{
  "id": "document_managers",
  "label": "Responsables documentaires",
  "description": "Profils en charge des documents et enregistrements.",
  "enabled": true,
  "legal_basis": "legitimate_interest_product_updates",
  "conditions": {
    "all": [
      { "field": "active", "operator": "equals", "value": true },
      { "field": "communication_eligible", "operator": "equals", "value": true },
      { "field": "role_key", "operator": "in", "value": ["document_manager", "records_manager"] }
    ]
  },
  "exclusions": ["opted_out", "invalid_email", "account_suspended"]
}
